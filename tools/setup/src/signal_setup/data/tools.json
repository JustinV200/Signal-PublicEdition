{
  "_comment": "Signal's tool registry, read by the setup CLI (tools/setup) and the setup skill (.claude/skills/setup). Paths are relative to the repo root, where every command runs. {email} is the address the user gave in an 'email' step. Step kinds: run (a command), copy (an example config, kept if it already exists), manual (instructions the user follows), confirm (a yes/no choice), email (asks an address and writes it into source constants), env (asks a non-secret value for .env), settings (creates the tool's config files from their examples and asks its settings, from data/settings/<tool>.json; done only when no placeholder is left; 'group' picks an optional group such as the assignment checker), samples (copytone writing samples). 'terminal' steps need the user's own interactive terminal, so the agent never runs them. A step's mcp/permissions apply only once that step is done; a tool's apply once all its required steps are done.",
  "tools": [
    {
      "id": "agents",
      "name": "Agent rules (AGENTS.md)",
      "description": "The rules every agent follows in this repo. Its one setting is when an agent stops and hands off to a fresh one as its context fills up.",
      "platforms": [
        "windows",
        "linux"
      ],
      "prereqs": [],
      "steps": [
        {
          "id": "settings",
          "title": "Choose when agents hand off (context threshold)",
          "kind": "settings",
          "optional": true,
          "default": true
        }
      ]
    },
    {
      "id": "brief",
      "name": "Catch-up brief and away mode",
      "description": "Sessions log what you should hear about; 'brief me' gives a ranked catch-up, and away mode tells sessions to keep working without you.",
      "platforms": [
        "windows"
      ],
      "prereqs": [
        "uv"
      ],
      "mcp": [
        "brief"
      ],
      "permissions": [
        "mcp__brief"
      ],
      "hooks": [
        {
          "event": "UserPromptSubmit",
          "module": "brief_tool.hooks.prompt",
          "isolated": true,
          "timeout": 10
        }
      ],
      "steps": [
        {
          "id": "install",
          "title": "Install",
          "kind": "run",
          "argv": [
            "uv",
            "sync",
            "--project",
            "tools/brief",
            "--frozen"
          ]
        }
      ],
      "verify": [
        "uv",
        "run",
        "--project",
        "tools/brief",
        "--frozen",
        "--no-sync",
        "brief",
        "away",
        "status"
      ]
    },
    {
      "id": "usage",
      "name": "Usage tracker",
      "description": "Keeps your 5-hour and weekly Claude usage and the running subagent count in one file, for the status line and the console.",
      "platforms": [
        "windows",
        "linux"
      ],
      "prereqs": [
        "uv"
      ],
      "hooks": [
        {
          "event": "SubagentStart",
          "module": "usage.hook",
          "isolated": true,
          "timeout": 5
        },
        {
          "event": "SubagentStop",
          "module": "usage.hook",
          "isolated": true,
          "timeout": 5
        }
      ],
      "steps": [
        {
          "id": "install",
          "title": "Install",
          "kind": "run",
          "argv": [
            "uv",
            "sync",
            "--project",
            "tools/usage",
            "--frozen"
          ]
        },
        {
          "id": "statusline",
          "title": "Show usage in Claude Code's status line (writes statusLine in your user settings, ~/.claude/settings.json)",
          "kind": "confirm",
          "optional": true,
          "default": true,
          "statusline": true
        }
      ],
      "verify": [
        "uv",
        "run",
        "--project",
        "tools/usage",
        "--frozen",
        "--no-sync",
        "usage",
        "show"
      ]
    },
