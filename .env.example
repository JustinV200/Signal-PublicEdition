# Copy to .env (gitignored) and fill in. .mcp.json loads .env via `uv run --env-file .env`, so the file must exist.
# Spotify Web API client ID for audiohub's music control (no secret needed).
SPOTIPY_CLIENT_ID=
# Your name in the console's messages to Claude ("[Signal console] <name>: ..."). Empty means "the owner"; quote a name with spaces.
SIGNAL_OWNER_NAME=
